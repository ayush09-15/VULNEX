PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Google AI Studio / Gemma Configuration (Method 3)
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=
# Supported models: gemma-2-9b-it, gemma-2-27b-it, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemma-2-9b-it
AI_TIMEOUT_MS=15000
WORKSPACE_ROOT=./.workspaces
MAX_UPLOAD_MB=25
SCAN_TIMEOUT_SECONDS=120
PATCH_TIMEOUT_SECONDS=60
TEST_TIMEOUT_SECONDS=120
MAX_CONCURRENT_SCANS=2
DATABASE_URL=
SEMGREP_BIN=semgrep
SEMGREP_CONFIG=auto
